# Copy to .env.integration.local and use dedicated staging/test resources only.
# The test module loads this file only when RUN_INTEGRATION_TESTS=1 is set.
ENVIRONMENT=staging
RAZORPAY_MODE=test
RUN_INTEGRATION_TESTS=0

# Supabase Auth/API values used by the API and VoltStop mobile build.
SUPABASE_URL=https://<staging-project-ref>.supabase.co
SUPABASE_ANON_KEY=<staging-anon-key>

# Runtime API database connection and the direct PostgreSQL integration probe.
DATABASE_URL=postgresql://<restricted-user>:<password>@<staging-db-host>:5432/postgres
SUPABASE_DB_URL=postgresql://<restricted-user>:<password>@<staging-db-host>:5432/postgres
REDIS_URL=rediss://<staging-redis-host>:6379/0

# Staging startup requires TEST mode and a matching rzp_test_ key prefix.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Client API URL names used by the mobile and vendor web applications.
VENDOR_PORTAL_ORIGIN=https://<staging-vendor-web-host>
API_BASE_URL=https://<staging-api-host>/api/v1
NEXT_PUBLIC_API_URL=https://<staging-api-host>/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<staging-anon-key>

# Descriptive deployment label. The automated opt-in gate is RUN_INTEGRATION_TESTS.
INTEGRATION_TEST_MODE=staging
