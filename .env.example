# Supabase project values (never commit real credentials)
ENVIRONMENT=development
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
BOOTSTRAP_ADMIN_EMAIL=
VENDOR_PORTAL_ORIGIN=http://localhost:3000
# Comma-separated exact HTTPS preview origins; keep empty unless explicitly needed.
VENDOR_PORTAL_PREVIEW_ORIGINS=
# Exact local/LAN HTTP origins are accepted only with ENVIRONMENT=development.
VENDOR_PORTAL_DEV_ORIGINS=http://192.168.1.10:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
BOOKING_LOCK_TTL_SECONDS=300
# Use only Razorpay Test Mode credentials for local payment testing.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional for local checkout testing; required only to verify Razorpay webhook deliveries.
RAZORPAY_WEBHOOK_SECRET=
OSRM_ROUTER_URL=https://router.project-osrm.org/route/v1/driving
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_URL=https://routes.googleapis.com/directions/v2:computeRoutes
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
API_HOST=0.0.0.0
API_PORT=8000
