NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Optional map tile override; defaults to OpenStreetMap tiles.
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional label shown in the admin console.
NEXT_PUBLIC_APP_ENV=Development
# Browser-safe Supabase config. Vercel integration SUPABASE_URL and
# SUPABASE_PUBLISHABLE_KEY are mapped to these names at build time.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
